<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The controller talks to a local-dream host over plain HTTP on the LAN,
         so cleartext must be allowed (not just for localhost). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>